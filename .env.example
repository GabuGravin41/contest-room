# Neon: use the POOLED connection string (host contains "-pooler")
DATABASE_URL=postgres://user:password@ep-xxxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require
# Official start, East Africa Time. The paper opens for everyone at this moment.
CONTEST_START=2026-10-10T09:00:00+03:00
CONTEST_MINUTES=150
# Optional: refuse first-time joins this many minutes after the start (leave empty to allow the whole window)
JOIN_UNTIL_MINUTES=
# Seconds between autosaves per student. 60 keeps 4000 students under Vercel Hobby limits.
SYNC_SECONDS=60
# Syncs arriving this long after the end are still stored (slow networks)
GRACE_SECONDS=120
# Long random string; needed to open /admin
ADMIN_KEY=change-me-to-a-long-random-string
# live = everyone starts at CONTEST_START. practice = each code gets its own clock from first entry (demos, rehearsals).
CONTEST_MODE=live
# Shown to students if the server can't be reached, as where to email their saved answers file
FALLBACK_EMAIL=
# 1 = each student sees multiple-choice options in their own order (recommended). 0 = same order for all.
SHUFFLE_MCQ=1
# Separate password for markers (marking page only, no admin powers)
MARKER_KEY=another-long-random-string
